{
  "name": "daraja-client",
  "version": "1.0.1",
  "description": "A modern, lightweight Node.js client for the M-Pesa Daraja API that simplifies authentication, STK Push, and payment integrations.",
  "keywords": [
    "mpesa",
    "daraja",
    "payments",
    "kenya",
    "fintech",
    "stk-push",
    "api",
    "sdk"
  ],
  "homepage": "https://github.com/BushMutali/daraja-client#readme",
  "bugs": {
    "url": "https://github.com/BushMutali/daraja-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BushMutali/daraja-client.git"
  },
  "license": "MIT",
  "author": "Bush Mutali",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "dev": "tsup src/index.ts --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "dotenv": "^17.4.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.2"
  }
}
