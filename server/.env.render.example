# ─────────────────────────────────────────────────────────────
#  DMC Foods API — environment for Render (Dashboard → dmc-foods-api → Environment)
#  Never commit real values. Render injects PORT automatically.
# ─────────────────────────────────────────────────────────────
NODE_ENV=production

# MongoDB Atlas (Render has no MongoDB). Atlas → Connect → Drivers. Pick AWS Frankfurt (eu-central-1)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dmcfoods?retryWrites=true&w=majority

# Long random strings (Render can generate these)
JWT_SECRET=<random-64-chars>
JWT_REFRESH_SECRET=<random-64-chars>

# Where the shop lives (CORS). Several allowed, comma separated.
CLIENT_ORIGIN=https://order.yourdomain.co.ke
# This API's public address (photo links point here)
PUBLIC_API_URL=https://api.yourdomain.co.ke
# strict  = shop and API on the same domain (order.x.co.ke + api.x.co.ke)  ← recommended
# none    = testing on *.onrender.com addresses (different sites)
COOKIE_SAMESITE=strict

# ── Safaricom Daraja (developer.safaricom.co.ke) ──
DARAJA_ENVIRONMENT=sandbox            # sandbox | production
DARAJA_TYPE=paybill                   # till (Buy Goods) | paybill
DARAJA_CONSUMER_KEY=<consumer-key>
DARAJA_CONSUMER_SECRET=<consumer-secret>
DARAJA_SHORTCODE=174379               # sandbox test paybill. LIVE TILL: your STORE (head-office) number
DARAJA_TILL_NUMBER=                   # LIVE TILL only: the till number customers pay to
DARAJA_PASSKEY=<passkey>              # sandbox passkey is on the Daraja test page; live one is emailed by Safaricom
MPESA_CALLBACK_URL=https://api.yourdomain.co.ke/api/v1/mpesa/callback
MPESA_CALLBACK_SECRET=<random-48-chars>   # added to the callback address; fakes without it are refused
